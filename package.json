{
  "name": "ai-chat-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm run build && npm run start:dev",
    "build": "tsc",
    "start:dev": "node --watch dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:seed": "npm run build && node dist/database/seeds/seed.js",
    "migration:create": "typeorm migration:create",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/database/data-source.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pino-http": "^5.8.4",
    "tsx": "^4.23.12",
    "typeorm-ts-node-esm": "^0.3.20",
    "typescript": "5.9"
  }
}